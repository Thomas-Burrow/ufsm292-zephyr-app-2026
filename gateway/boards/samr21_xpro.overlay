/* PA28 is the Ethernet reset line on EXT1; keep the button off it. */
&user_button {
	status = "disabled";
};

 / {
 	example_sensor: example-sensor {
 		compatible = "zephyr,example-sensor";
 		input-gpios = <&porta 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		status = "disabled";
	};
	blink_led: blink-led {
		compatible = "blink-gpio-led";
		led-gpios = <&porta 19 GPIO_ACTIVE_LOW>;
		blink-period-ms = <1000>;
	};
};

/* Ethernet1 on EXT1: CS PB3, IRQ PA22, reset PA28 (shared with SW0). */
&sercom5 {
	status = "okay";
	compatible = "atmel,sam0-spi";
	#address-cells = <1>;
	#size-cells = <0>;
	/* PAD2 MOSI / PAD3 SCLK: SAM R21 datasheet Table 25-7. */
	dopo = <1>;

	cs-gpios = <&portb 3 GPIO_ACTIVE_LOW>;

	eth_ksz8851: ethernet@0 {
		compatible = "microchip,ksz8851snl";
		reg = <0>;
		spi-max-frequency = <1000000>;
		int-gpios = <&porta 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		reset-gpios = <&porta 28 GPIO_ACTIVE_LOW>;
		local-mac-address = [02 04 A3 12 34 56];
		status = "okay";
	};
};